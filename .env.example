# =============================================================================
# TG-jev-chatbot 环境变量示例 / Environment example
# 复制本文件为 .env 后填写。切勿把真实 .env 提交到 Git。
# Copy to .env and fill in. Never commit a real .env.
# =============================================================================

# 【必填 / Required】BotFather 发给你的 HTTP API Token（形如 123456:ABC...）
# 从 @BotFather → /newbot 或 /token 获取。泄露请立刻 /revoke。
# BotFather HTTP API token. Revoke immediately if leaked.
BOT_TOKEN=

# 【建议先留空 / Can start empty】论坛超级群的 chat id（负数，通常以 -100 开头）
# 留空时进入 SETUP_MODE：可跑 Bot，用群内 /groupid 拿到数字后再填，并重启。
# Forum supergroup id (negative, often -100…). Leave empty for guided setup;
# send /groupid in the group, paste here, then restart the bot.
FORUM_GROUP_ID=

# 【可选 / Optional】新话题标题模板。可用占位符：{name} {id} {username}
# Topic title template. Placeholders: {name} {id} {username}
# TOPIC_NAME_TEMPLATE={name} · {id}

# 【可选 / Optional】SQLite 映射库路径（默认 ./data/mappings.sqlite）
# SQLite path for user↔topic mappings (default ./data/mappings.sqlite)
# DB_PATH=./data/mappings.sqlite

# 【可选 / Optional】Jev 建议回复开关（默认开启）。设为 0 / false / off 关闭。
# Jev suggested replies (default ON). Set 0/false/off to disable.
# JEV_ENABLED=1

# 【可选 / Optional】固定话术 JSON、知识库 Markdown 路径
# Paths for scripts JSON and knowledge Markdown
# JEV_SCRIPTS_PATH=./data/scripts.json
# JEV_KNOWLEDGE_PATH=./data/knowledge.md
