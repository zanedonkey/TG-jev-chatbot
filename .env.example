# Required: BotFather HTTP API token
BOT_TOKEN=

# Required: Forum-enabled Supergroup id (negative, often starts with -100)
# How to get it: add the bot as admin, send /groupid in the group, or see README.
FORUM_GROUP_ID=

# Optional: topic title template. Placeholders: {name} {id} {username}
# TOPIC_NAME_TEMPLATE={name} · {id}

# Optional: SQLite path (default: ./data/mappings.sqlite)
# DB_PATH=./data/mappings.sqlite

# Optional: Jev suggested replies (default ON). Set 0/false to disable.
# JEV_ENABLED=1
# JEV_SCRIPTS_PATH=./data/scripts.json
# JEV_KNOWLEDGE_PATH=./data/knowledge.md
